<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Raylib.Packaging.props" />

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <RootNamespace>Novolis.Raylib</RootNamespace>
    <AssemblyName>Novolis.Raylib.Raygui</AssemblyName>
    <PackageId>Novolis.Raylib.Raygui</PackageId>
    <IsPackable>true</IsPackable>
    <Description>raygui 5.0 widgets add-on for Novolis.Raylib (optional; requires novolis_raygui native).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Novolis.Raylib.CodeGen.Unit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novolis.Raylib.Runtime\Novolis.Raylib.Runtime.csproj" />
    <ProjectReference Include="..\Novolis.Raylib.Raygui.Native\Novolis.Raylib.Raygui.Native.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(MSBuildThisFileDirectory)..\..\codegen\native\raylib6-with-raygui\out\novolis_raygui.dll"
          Link="novolis_raygui.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\codegen\native\raylib6-with-raygui\out\novolis_raygui.dll')" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(MSBuildThisFileDirectory)..\..\codegen\native\raylib6-with-raygui\out\libnovolis_raygui.so"
          Link="libnovolis_raygui.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\codegen\native\raylib6-with-raygui\out\libnovolis_raygui.so')" />
  </ItemGroup>

</Project>
