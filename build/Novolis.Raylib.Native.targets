<Project>
  <!-- Copy RID native assets from the nupkg (not repo build output paths). -->
  <Target Name="CopyNovolisRaylibNativeAssets" AfterTargets="Build"
          Condition="!$([System.String]::Copy('$(TargetFramework)').Contains('-android'))">
    <PropertyGroup>
      <_NovolisRaylibCopyRid>$(RuntimeIdentifier)</_NovolisRaylibCopyRid>
      <_NovolisRaylibCopyRid Condition="'$(_NovolisRaylibCopyRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_NovolisRaylibCopyRid>
      <_NovolisRaylibCopyRid Condition="'$(_NovolisRaylibCopyRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_NovolisRaylibCopyRid>
      <_NovolisRaylibCopyRid Condition="'$(_NovolisRaylibCopyRid)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx-x64</_NovolisRaylibCopyRid>
    </PropertyGroup>
    <ItemGroup>
      <_NovolisRaylibNativeRuntime Include="$(MSBuildThisFileDirectory)..\runtimes\$(_NovolisRaylibCopyRid)\native\*"
                                   Condition="'$(_NovolisRaylibCopyRid)' != ''" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_NovolisRaylibNativeRuntime)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="'@(_NovolisRaylibNativeRuntime)' != ''" />
  </Target>

  <!--
    Android: inject NativeActivity host .so into APK lib/arm64-v8a.
    Nupkg layout: buildTransitive/../runtimes/...
    Repo layout (Import from build/): ../src/Novolis.Raylib.Native/runtimes/...
  -->
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').Contains('-android'))">
    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\runtimes\android-arm64\native\libnovolis_raylib_android.so"
                          Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\android-arm64\native\libnovolis_raylib_android.so')">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
    <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\src\Novolis.Raylib.Native\runtimes\android-arm64\native\libnovolis_raylib_android.so"
                          Condition="Exists('$(MSBuildThisFileDirectory)..\src\Novolis.Raylib.Native\runtimes\android-arm64\native\libnovolis_raylib_android.so')">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>
</Project>
